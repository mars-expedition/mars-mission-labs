# Azure OpenAI: dirección de tu recurso, SIN /openai/v1 al final
AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=<tu-clave>
# Nombre de tu implementación del modelo (p.ej. gpt-5-mini-1)
AZURE_OPENAI_CHAT_COMPLETION_MODEL=<nombre-de-tu-implementacion>

# Observabilidad (capítulo 1): spans impresos en tu propia terminal, sin infraestructura
ENABLE_CONSOLE_EXPORTERS=true
# Captura prompts, respuestas y argumentos de tools en los spans (solo dev/test)
# ENABLE_SENSITIVE_DATA=true

# Observabilidad (capítulo 1, paso 3, opción 1): Azure Application Insights (sin Docker, sin OTLP)
# Copia la cadena de conexión de tu recurso en Application Insights > Overview > Connection String
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<tu-key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
# OTEL_SERVICE_NAME=mars-mission-control

# Observabilidad (capítulo 1, paso 4, opción 2): sin Docker, un Tempo de Grafana Cloud por OTLP/HTTP
# Saca estos valores de tu stack de Grafana Cloud en Connections > OpenTelemetry
# Nota: usa la variable ESPECÍFICA de trazas (no la genérica OTEL_EXPORTER_OTLP_ENDPOINT), porque
# Tempo solo acepta trazas; la genérica también manda métricas y logs, que Tempo no sabe recibir.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp/v1/traces
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <tu-token-en-base64>
# OTEL_SERVICE_NAME=mars-mission-control
# ENABLE_SENSITIVE_DATA=true
