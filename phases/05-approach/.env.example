# Azure OpenAI: dirección de tu recurso, SIN /openai/v1 al final
AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=<tu-clave>
# Nombre de tu implementación del modelo de chat (p.ej. gpt-5-mini-1)
AZURE_OPENAI_CHAT_COMPLETION_MODEL=<nombre-de-tu-implementacion-chat>
# Nombre de tu implementación de embeddings (p.ej. text-embedding-3-small-1), la usa Mem0 en el capítulo 2
AZURE_OPENAI_EMBEDDING_MODEL=<nombre-de-tu-implementacion-embeddings>
# Dirección de tu Redis local, la usa el capítulo 1
REDIS_URL=redis://localhost:6379
