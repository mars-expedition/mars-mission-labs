# Azure OpenAI / Foundry model deployments
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_CHAT_MODEL=<chat-deployment-name>
AZURE_OPENAI_CHAT_COMPLETION_MODEL=<chat-deployment-name>
AZURE_OPENAI_CHAT_COMPLETION_API_VERSION=2024-02-15-preview
# Leave empty for Microsoft Agent Framework Responses API auto-selection.
AZURE_OPENAI_RESPONSES_API_VERSION=
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_MODEL_NAME=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_API_VERSION=2025-04-01-preview
# Optional: only needed if your Search service does not use managed identity
# AZURE_OPENAI_API_KEY=<openai-api-key>

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<search-service-name>.search.windows.net
AZURE_SEARCH_INDEX=rag-nasa-agent-demo
AZURE_SEARCH_API_VERSION=2025-09-01
EMBEDDING_DIMENSIONS=1536

# Azure Blob Storage used by the Azure AI Search indexer
# Option A: use an account key connection string
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<storage-account>;AccountKey=<storage-key>;EndpointSuffix=core.windows.net
# Option B: use Azure AD / managed identity
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_RESOURCE_GROUP=<resource-group-name>
AZURE_STORAGE_ACCOUNT_NAME=<storage-account-name>
AZURE_STORAGE_ACCOUNT_URL=https://<storage-account-name>.blob.core.windows.net
AZURE_STORAGE_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group-name>/providers/Microsoft.Storage/storageAccounts/<storage-account-name>
AZURE_STORAGE_CONTAINER=mars-rag
AZURE_STORAGE_BLOB_PREFIX=mars-rag

# Azure AI Search Text Split Skill
AZURE_SEARCH_TEXT_SPLIT_MODE=pages
AZURE_SEARCH_TEXT_SPLIT_UNIT=characters
AZURE_SEARCH_TEXT_SPLIT_MAX_LENGTH=3500
AZURE_SEARCH_TEXT_SPLIT_OVERLAP=500
AZURE_SEARCH_TEXT_SPLIT_LANGUAGE=en
RESET_SEARCH_ASSETS=true
WAIT_FOR_INDEXER=true

# Azure AI Foundry native agent
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-project>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_AGENT_NAME=marsrag-native-agent
FOUNDRY_SEARCH_CONNECTION_NAME=
FOUNDRY_SEARCH_CONNECTION_ID=

# Local demo limits
MAX_PDFS=10
