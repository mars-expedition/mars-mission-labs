# Prefer ../.env.example when running the tutorial from phases/04-transit.
# Keep this copy only for users who run scripts directly inside tutorial/.

# Azure OpenAI / Foundry model deployments
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_CHAT_MODEL=<chat-deployment-name>
AZURE_OPENAI_CHAT_COMPLETION_MODEL=<chat-deployment-name>
AZURE_OPENAI_CHAT_COMPLETION_API_VERSION=2024-02-15-preview
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_API_VERSION=2025-04-01-preview

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<search-service-name>.search.windows.net
AZURE_SEARCH_INDEX=rag-nasa-agent-demo
EMBEDDING_DIMENSIONS=1536

# Azure AI Foundry native agent
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-project>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_AGENT_NAME=marsrag-native-agent

# Local demo limits
MAX_PDFS=10
